{
  "symbia": "graph/1.0",
  "name": "energy-ingest",
  "version": "1.0.0",
  "description": "Ingest path for energy meter readings. Entry passthrough, validity filter (a reading must carry a value), audit log, terminal collect. Rejected readings fall out on the filter's fail port and appear in the execution trace.",
  "author": "energy",
  "nodes": [
    { "id": "entry", "component": "symbia.io.passthrough" },
    { "id": "valid", "component": "symbia.logic.filter",
      "config": { "field": "value", "op": "exists" } },
    { "id": "audit", "component": "symbia.io.log" },
    { "id": "sink", "component": "symbia.io.collect" }
  ],
  "edges": [
    { "id": "e1", "source": { "node": "entry", "port": "out" }, "target": { "node": "valid", "port": "in" } },
    { "id": "e2", "source": { "node": "valid", "port": "pass" }, "target": { "node": "audit", "port": "in" } },
    { "id": "e3", "source": { "node": "audit", "port": "out" }, "target": { "node": "sink", "port": "in" } }
  ],
  "metadata": { "domain": "energy", "role": "ingest" }
}
