{
  "dxt_version": "0.1",
  "name": "Symbia",
  "version": "1.0.0",
  "description": "Query the locally running Symbia stack: services, catalog, assistants, logs, components, models, network.",
  "long_description": "Read-only MCP access to the nine Symbia services running in Docker on localhost (identity, logging, catalog, assistants, messaging, runtime, integrations, models, network). Authenticates against the Identity service. Built from ~/symbia-stack/symbia-mcp-server.",
  "author": {
    "name": "Brian Gilmore"
  },
  "server": {
    "type": "node",
    "entry_point": "server/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/index.js"
      ],
      "env": {}
    }
  },
  "tools": [
    { "name": "symbia_stack_health", "description": "Health + version of all nine services" },
    { "name": "symbia_list_resources", "description": "List/filter catalog resources" },
    { "name": "symbia_get_resource", "description": "Fetch one catalog resource" },
    { "name": "symbia_list_assistants", "description": "List assistants" },
    { "name": "symbia_list_log_streams", "description": "List log streams" },
    { "name": "symbia_query_logs", "description": "Query log entries with filters" },
    { "name": "symbia_list_components", "description": "List runtime graph components" },
    { "name": "symbia_list_models", "description": "List local LLM models" },
    { "name": "symbia_integration_status", "description": "Integrations providers + registry" },
    { "name": "symbia_list_organizations", "description": "List organizations" },
    { "name": "symbia_list_network_nodes", "description": "List network mesh nodes" }
  ],
  "keywords": ["mcp", "symbia", "local"],
  "license": "MIT"
}
