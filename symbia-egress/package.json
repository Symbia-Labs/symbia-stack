{
  "name": "@symbia/egress",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Outbound egress guard: block SSRF to loopback, private, link-local and metadata addresses for Symbia component/action fetches",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "symbia",
    "ssrf",
    "egress",
    "security",
    "network"
  ]
}
