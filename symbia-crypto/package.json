{
  "name": "@symbia/crypto",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Canonical serialization, digests and ed25519 identity for Symbia services",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx scripts/test-crypto.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "symbia",
    "crypto",
    "canonical-json",
    "ed25519",
    "provenance"
  ]
}
