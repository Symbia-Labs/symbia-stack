# Symbia Stack Configuration
# Copy this file to .env and modify as needed
# All values shown are defaults - only set what you want to change

# =============================================================================
# Port Configuration
# =============================================================================
# Customize host ports if defaults conflict with other services
# Container ports remain fixed for internal service communication

# POSTGRES_PORT=5432
# IDENTITY_PORT=5001
# LOGGING_PORT=5002
# CATALOG_PORT=5003
# ASSISTANTS_PORT=5004
# MESSAGING_PORT=5005
# RUNTIME_PORT=5006
# INTEGRATIONS_PORT=5007
# MODELS_PORT=5008
# NETWORK_PORT=5009
# API_PORT=9000
# CONTROL_CENTER_PORT=8000

# =============================================================================
# Database Configuration
# =============================================================================
# POSTGRES_USER=symbia
# POSTGRES_PASSWORD=symbia_dev
# POSTGRES_DB=symbia

# =============================================================================
# Security (change these in production!)
# =============================================================================
# SESSION_SECRET=symbia-dev-secret-change-in-production
# NETWORK_HASH_SECRET=symbia-network-dev-secret
# Catalog internal service credential. When set, service-to-service writes to the
# catalog must send this exact value in the X-Service-Auth header (a real secret,
# not the spoofable literal "internal"). Leave unset for local dev.
# CATALOG_INTERNAL_SERVICE_TOKEN=change-me-in-production

# =============================================================================
# Runtime: catalog edge (roadmap Phase 1)
# =============================================================================
# The catalog is the source of truth for components and graphs; the runtime is
# the handler. On boot the runtime publishes its component manifests, hydrates
# published graph resources, and stands up those declared role: pipeline|service.

# How hard to enforce that a graph node's component has a registered catalog
# manifest. strict = refuse to load (default), warn = log and load, off = skip.
# Strict is the default deliberately: a gate that is skipped by default is not a
# gate. In strict mode an unreachable catalog fails graph loads rather than
# silently falling back to trusting the in-process registry.
# RUNTIME_MANIFEST_ENFORCEMENT=strict

# Publish this runtime's component manifests to the catalog on boot.
# RUNTIME_REGISTER_MANIFESTS=true
# Load published graph resources from the catalog on boot.
# RUNTIME_HYDRATE_GRAPHS=true
# Auto-execute hydrated graphs declaring role: pipeline|service.
# RUNTIME_AUTO_EXECUTE=true
# Reconcile poll interval in ms; 0 disables the loop (boot-only sync).
# Polling is interim — Network-event-driven is the target.
# RUNTIME_RECONCILE_INTERVAL_MS=30000
# Exit if the boot-time catalog sync fails, instead of degrading.
# RUNTIME_CATALOG_FAIL_FAST=false
# Version stamped on published manifests; bump to force a manifest update.
# RUNTIME_COMPONENT_CONTRACT_VERSION=1.1.0
# Capability a caller must hold to execute a runtime component.
# RUNTIME_COMPONENT_CAPABILITY=cap:runtime.execute

# Register each hydrated graph's ingress as a catalog resource, so the delivery
# surface is declared and discoverable rather than implicit.
# RUNTIME_REGISTER_INGRESS=true

# Ingress authorization (roadmap Phase 2). strict = enforce the declared gate,
# warn = log what would be refused and allow it, off = authenticate only.
# Strict by default: authentication is not authorization, and an ingress any
# logged-in principal can post to is not a gated capability. Under strict, a
# graph with neither an owning org nor a declared ingress capability is an
# undeclared surface and delivery to it is refused — register the graph with
# an --org so the gate has something to check.
# RUNTIME_INGRESS_ENFORCEMENT=strict

# Durable operator state (roadmap Phase 3). State is keyed by the graph's
# catalog key and node id — NOT by execution id, which is regenerated on every
# start and so could never be resumed. Flush interval in ms: writes are cached
# and flushed asynchronously so the execution path stays synchronous, which
# means an unclean crash can lose up to this much operator state. SIGTERM
# flushes before exit, so planned restarts lose nothing.
# RUNTIME_STATE_FLUSH_MS=2000
# Force in-memory (pg-mem) state even when DATABASE_URL is set. State is then
# lost on restart, and the runtime says so at boot.
# RUNTIME_USE_MEMORY_DB=false

# =============================================================================
# LLM Provider API Keys
# =============================================================================
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# HUGGINGFACE_TOKEN=hf_...

# =============================================================================
# Local Models Configuration (Models Service)
# =============================================================================
# MAX_LOADED_MODELS=2           # Max models loaded in memory simultaneously
# IDLE_TIMEOUT_MS=300000        # Unload after 5 minutes of inactivity
# DEFAULT_GPU_LAYERS=0          # GPU acceleration (0 = CPU only)
# DEFAULT_THREADS=4             # CPU threads for inference

# =============================================================================
# OAuth (Integrations Service)
# =============================================================================
# Where a user's BROWSER is sent when an OAuth callback fails. This must be a
# URL reachable from outside the stack; the service knows the port it was
# registered on, not the address a browser reaches it at, so it cannot derive
# one. Unset, it falls back to the control center on localhost:8000, which is
# correct for local development and wrong for every deployment.
#
# It previously fell back to a hardcoded localhost URL on a port retired when
# the admin front end moved, pointing at a marketing site no longer in this
# repo. Neither variable was set anywhere, so that dead address was not an edge
# case; it was the only path the code ever took. (The retired number is not
# written here on purpose: check-ports.ts fails the build on a retired port in
# an operational file, and it does not read comments differently from config —
# which is the correct trade. See docs/2026-08-08-repo-inventory.md.)
# OAUTH_ERROR_REDIRECT_URL=https://console.example.com
# WEBSITE_URL=https://example.com
