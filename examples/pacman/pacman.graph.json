{
  "symbia": "graph/1.0",
  "name": "pacman",
  "version": "1.0.0",
  "author": "imagine",
  "description": "Pac-Man as a dataflow graph. The maze is the switch port list; walls are the default branch. The win condition is a rollup over the dots: while any remain the board is apocryphal and names them.",
  "nodes": [
    {
      "id": "entry",
      "component": "symbia.io.passthrough"
    },
    {
      "id": "dir",
      "component": "symbia.logic.switch",
      "config": {
        "field": "dir",
        "ports": [
          "up",
          "down",
          "left",
          "right"
        ]
      }
    },
    {
      "id": "mv_up",
      "component": "symbia.compute.arithmetic",
      "config": {
        "expression": "{pos} - 7"
      }
    },
    {
      "id": "mv_down",
      "component": "symbia.compute.arithmetic",
      "config": {
        "expression": "{pos} + 7"
      }
    },
    {
      "id": "mv_left",
      "component": "symbia.compute.arithmetic",
      "config": {
        "expression": "{pos} - 1"
      }
    },
    {
      "id": "mv_right",
      "component": "symbia.compute.arithmetic",
      "config": {
        "expression": "{pos} + 1"
      }
    },
    {
      "id": "shape",
      "component": "symbia.transform.map",
      "config": {
        "mapping": {
          "pos": "result",
          "key": "result",
          "value": "exact"
        }
      }
    },
    {
      "id": "maze",
      "component": "symbia.logic.switch",
      "config": {
        "field": "pos",
        "ports": [
          "8",
          "9",
          "10",
          "11",
          "12",
          "15",
          "17",
          "19",
          "22",
          "23",
          "24",
          "25",
          "26",
          "29",
          "31",
          "33",
          "36",
          "37",
          "38",
          "39",
          "40"
        ]
      }
    },
    {
      "id": "board",
      "component": "symbia.state.rollup",
      "config": {
        "expected": [
          "9",
          "10",
          "11",
          "12",
          "15",
          "17",
          "19",
          "22",
          "23",
          "24",
          "25",
          "26",
          "29",
          "31",
          "33",
          "36",
          "37",
          "38",
          "39",
          "40"
        ],
        "op": "sum",
        "keyField": "key",
        "valueField": "value"
      }
    },
    {
      "id": "moved",
      "component": "symbia.io.collect"
    },
    {
      "id": "blocked",
      "component": "symbia.io.collect"
    },
    {
      "id": "badmove",
      "component": "symbia.io.collect"
    }
  ],
