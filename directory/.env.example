# Directory Service — federation control plane
# Port is derived from @symbia/sys (5010). Override only if you know why.
# DIRECTORY_PORT=5010
HOST=0.0.0.0

# Admission (design §6, phase 1). Unset = OPEN admission (dev / trusted
# boundary only). Set before exposing the directory across a boundary.
# DIRECTORY_JOIN_SECRET=

# Foreign-node (FDT) sweep + default TTL.
# DIRECTORY_EVICT_INTERVAL_MS=15000
# DIRECTORY_FOREIGN_TTL_SECONDS=60
