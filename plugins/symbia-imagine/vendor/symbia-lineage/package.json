{
  "name": "@symbia/lineage",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Signed, chained observation records for anything entering the system as context",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@symbia/crypto": "*"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "symbia",
    "lineage",
    "provenance",
    "attestation",
    "observer"
  ],
  "_vendored": "dist only; build-time declarations stripped by vendor-libs.sh"
}
